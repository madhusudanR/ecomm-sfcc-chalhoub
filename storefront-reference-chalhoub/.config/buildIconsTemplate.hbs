@charset "UTF-8";

@if not variable-exists('webfont-icons') {
    $webfont-icons: () !global;
}

$webfont-icons: (
    {{#each codepoints}}
    '{{@key}}': '\\{{this}}',
    {{/each}}
);

@mixin icon-typography() {
    font-family: $font-icons;
    -webkit-font-smoothing: antialiased;
    -moz-osx-font-smoothing: grayscale;
    font-style: normal;
    font-variant: normal;
    font-weight: normal;
    text-decoration: none;
    text-transform: none;
    vertical-align: baseline;
}

@mixin icon($name, $after: false) {
    line-height: 1;

    @if $after {
        &::after {
            @include icon-typography;
            $icon: map-get($webfont-icons, $name);

            content: $icon;
            @content;
        }
    }

    @else {
        &::before {
            @include icon-typography;
            $icon: map-get($webfont-icons, $name);

            content: $icon;
            @content;
        }
    }
}
{{#each codepoints}}

.icon-{{@key}} {
    @include icon('{{@key}}');
}

.icon-{{@key}}--after {
    @include icon('{{@key}}', true);
}
{{/each}}
